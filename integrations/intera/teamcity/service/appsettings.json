{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "TeamCity": {
    "ServerUrl": "",
    "Token": "",
    "Projects": [],
    "TestBuildLookback": 5,
    "MaxBuildTypes": 100,
    "MaxTestsPerBuild": 10000,
    "MaxParallelRequests": 4,
    "HttpTimeoutSeconds": 60
  }
}

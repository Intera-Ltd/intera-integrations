{
    "Serilog":  {
                    "MinimumLevel":  {
                                         "Default":  "Information",
                                         "Override":  {
                                                          "Microsoft":  "Warning",
                                                          "Microsoft.Hosting.Lifetime":  "Information",
                                                          "System.Net.Http.HttpClient":  "Warning"
                                                      }
                                     },
                    "Enrich":  [
                                   "FromLogContext"
                               ]
                },
    "Jira":  {
                 "ClientId":  "",
                 "ClientSecret":  "",
                 "RedirectUri":  "",
                 "RedirectUriFilePath":  "App_Data/jira-redirect-uri.json",
                 "SiteUrl":  "",
                 "JqlScope":  "",
                 "IssueCustomFields":  "",
                 "OAuthTokenFilePath":  "App_Data/jira-oauth-token.json",
                 "AccessTokenRefreshSkewSeconds":  120,
                 "RefreshTokenKeepAliveDays":  7,
                 "MaxIssuesPerRead":  20000,
                 "MaxRecordsPerList":  200000,
                 "SearchPageSize":  100,
                 "PageSize":  100,
                 "WorklogPerIssueMaxIssues":  50,
                 "MaxCommentIssues":  500,
                 "MaxFanout":  500,
                 "MaxParallelRequests":  4,
                 "MaxRetryAfterSeconds":  60,
                 "HttpTimeoutSeconds":  100,
                 "CacheSeconds":  120,
                 "ReferenceCacheSeconds":  900
             }
}

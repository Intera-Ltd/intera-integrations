{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Soft1": {
    "ServiceUrl": "",
    "Username": "",
    "Password": "",
    "AppId": "",
    "Company": "",
    "Branch": "",
    "Module": "",
    "RefId": "",
    "PageSize": 500,
    "MaxRowsPerRead": 50000,
    "MaxRecordReadsPerQuery": 2000,
    "MaxParallelRequests": 4,
    "HttpTimeoutSeconds": 120,
    "DefaultFiscalYears": 2,
    "MaxFiscalYears": 5,
    "Reads": {}
  }
}

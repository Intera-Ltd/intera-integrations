{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@intera-integrations/shared": ["../../../../shared/ts/index.ts"],
      "@intera-integrations/shared/*": ["../../../../shared/ts/*"]
    }
  },
  "include": ["src/**/*.ts", "../../../../shared/ts/**/*.ts"]
}

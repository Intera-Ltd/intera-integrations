{
    "Serilog":  {
                    "MinimumLevel":  {
                                         "Default":  "Information",
                                         "Override":  {
                                                          "Microsoft":  "Warning",
                                                          "Microsoft.Hosting.Lifetime":  "Information",
                                                          "System.Net.Http.HttpClient":  "Warning"
                                                      }
                                     },
                    "Enrich":  [
                                   "FromLogContext"
                               ]
                },
    "Zendesk":  {
                    "Subdomain":  "",
                    "BaseUrl":  "",
                    "ClientId":  "",
                    "ClientSecret":  "",
                    "RedirectUri":  "",
                    "RedirectUriFilePath":  "App_Data/zendesk-redirect-uri.json",
                    "Scopes":  "read",
                    "OAuthTokenFilePath":  "App_Data/zendesk-oauth-token.json",
                    "AccessTokenRefreshSkewSeconds":  120,
                    "RefreshTokenKeepAliveDays":  3,
                    "UseIncrementalExport":  false,
                    "TicketCustomFields":  "",
                    "PageSize":  100,
                    "MaxRecordsPerRead":  200000,
                    "MaxFanoutTickets":  500,
                    "MaxParallelRequests":  4,
                    "MaxRetryAfterSeconds":  60,
                    "HttpTimeoutSeconds":  100,
                    "CacheSeconds":  120,
                    "ReferenceCacheSeconds":  900
                }
}

{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Unleashed": {
    "ApiBaseUrl": "https://api.unleashedsoftware.com",
    "ApiId": "",
    "ApiKey": "",
    "ClientType": "intera/unleashed",
    "PageSize": 200,
    "MaxPages": 20,
    "MaxWarehouses": 50,
    "MaxParallelRequests": 4,
    "CatalogCacheSeconds": 300,
    "HttpTimeoutSeconds": 100
  }
}

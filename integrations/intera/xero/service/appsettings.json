{
    "Serilog":  {
                    "MinimumLevel":  {
                                         "Default":  "Information",
                                         "Override":  {
                                                          "Microsoft":  "Warning",
                                                          "Microsoft.Hosting.Lifetime":  "Information",
                                                          "System.Net.Http.HttpClient":  "Warning"
                                                      }
                                     },
                    "Enrich":  [
                                   "FromLogContext"
                               ]
                },
    "Xero":  {
                 "ClientId":  "",
                 "ClientSecret":  "",
                 "RedirectUri":  "",
                 "RedirectUriFilePath":  "App_Data/xero-redirect-uri.json",
                 "TenantId":  "",
                 "ApiAccessToken":  "",
                 "OAuthTokenFilePath":  "App_Data/xero-oauth-token.json",
                 "AccessTokenRefreshSkewSeconds":  120,
                 "RefreshTokenKeepAliveDays":  7,
                 "PageSize":  1000,
                 "MaxRowsPerRead":  20000,
                 "MaxParallelRequests":  4,
                 "MaxRetryAfterSeconds":  60,
                 "HttpTimeoutSeconds":  100,
                 "CacheSeconds":  60,
                 "ReferenceCacheSeconds":  600,
                 "MaxReportMonths":  36,
                 "MaxReportCalls":  36,
                 "MaxAgedContacts":  25,
                 "MaxBudgets":  50
             }
}

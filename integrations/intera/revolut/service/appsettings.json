{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Revolut": {
    "ApiBaseUrl": "https://b2b.revolut.com/api/1.0",
    "BusinessPortalBaseUrl": "https://business.revolut.com",
